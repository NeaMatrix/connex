{
    "name": "neamatrix/laravel-connex",
    "description": "Laravel integration for the Connex (Ebtekar) direct carrier billing platform: anti-fraud OTP login, subscriptions, purchases and webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "connex",
        "ebtekar",
        "dcb",
        "direct-carrier-billing",
        "otp",
        "subscriptions",
        "libyana",
        "almadar"
    ],
    "homepage": "https://github.com/NeaMatrix/connex",
    "authors": [
        {
            "name": "NeaMatrix",
            "homepage": "https://github.com/NeaMatrix"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "laravel/sanctum": "^4.4",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "suggest": {
        "laravel/sanctum": "Required to issue API tokens to apps and frontends with the bundled SanctumTokenIssuer."
    },
    "autoload": {
        "psr-4": {
            "NeaMatrix\\Connex\\": "src/",
            "NeaMatrix\\Connex\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeaMatrix\\Connex\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "check": [
            "@format --test",
            "@analyse",
            "@test"
        ],
        "demo": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "NeaMatrix\\Connex\\ConnexServiceProvider"
            ],
            "aliases": {
                "Connex": "NeaMatrix\\Connex\\Facades\\Connex"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/NeaMatrix/connex/issues",
        "source": "https://github.com/NeaMatrix/connex"
    }
}
